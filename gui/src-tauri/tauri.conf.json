{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroAgents",
  "mainBinaryName": "zeroagents-gui",
  "version": "0.4.0",
  "identifier": "dev.raulplz.zeroagents",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ZeroAgents",
        "width": 1320,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#080b10"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": false,
    "category": "DeveloperTool",
    "shortDescription": "Monitor ZERØ de agentes de Claude Code",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
